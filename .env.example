# Gemini AI
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL / frontend base
APP_URL="MY_APP_URL"
VITE_API_BASE_URL=""

# Supabase
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare R2 / S3-compatible storage
CF_R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
CF_R2_ACCOUNT_ID="YOUR_ACCOUNT_ID"
CF_R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
CF_R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
CF_R2_BUCKET_NAME="YOUR_BUCKET_NAME"
CF_R2_PUBLIC_BASE_URL=""

# Deployment
NODE_ENV="production"
VERCEL="1"