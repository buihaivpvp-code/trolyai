# Object storage configuration for Vercel backend
# Supports both Cloudflare R2 and generic S3-compatible storage.
# Copy these values into your real Vercel / server environment.
# Do NOT commit real secrets.

# ------------------------------------------------------------
# Preferred generic S3-compatible variables
# ------------------------------------------------------------
STORAGE_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=your_storage_access_key_id
STORAGE_S3_SECRET_ACCESS_KEY=your_storage_secret_access_key
STORAGE_S3_BUCKET=your-bucket-name

# Optional
# Set to false only if your provider requires virtual-hosted style access.
STORAGE_S3_FORCE_PATH_STYLE=true

# Optional public/custom domain for direct object access
# Example:
# STORAGE_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev
# or
# STORAGE_PUBLIC_BASE_URL=https://files.yourdomain.com
STORAGE_PUBLIC_BASE_URL=

# ------------------------------------------------------------
# Backward-compatible Cloudflare R2 variables
# ------------------------------------------------------------
# You may keep using these if already configured.
CF_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com/your-bucket-name
CF_R2_ACCOUNT_ID=your_account_id
CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CF_R2_BUCKET_NAME=your-bucket-name
CF_R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------
# Supabase configuration
# ------------------------------------------------------------
# Use the service role key on the backend only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional frontend Vite variables if the client also needs Supabase directly
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------
# Vercel runtime notes
# ------------------------------------------------------------
# - Do not rely on local ./data or ./uploads persistence on Vercel.
# - Student/user/journal data should live in Supabase tables.
# - Uploaded documents should live in S3/R2 object storage.
# - Keep secrets in the Vercel Project Settings -> Environment Variables.